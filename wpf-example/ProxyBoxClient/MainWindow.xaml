<Window x:Class="ProxyBoxClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProxyBoxClient"
        mc:Ignorable="d"
        Title="ProxyBox Client" Height="700" Width="1000" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Panel - Navigation -->
        <Border Grid.Column="0" Background="#f5f5f5" Padding="10">
            <StackPanel>
                <TextBlock Text="ProxyBox Client" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <Button Content="🌐 New Page" Margin="0,5" Padding="10" 
                        Command="{Binding NewPageCommand}" Background="#2196F3" Foreground="White"/>
                <Button Content="📷 Screenshot" Margin="0,5" Padding="10" 
                        Command="{Binding ScreenshotCommand}" Background="#4CAF50" Foreground="White"/>
                <Button Content="🔄 Reload" Margin="0,5" Padding="10" 
                        Command="{Binding ReloadCommand}" Background="#FF9800" Foreground="White"/>
                <Button Content="📄 HTML" Margin="0,5" Padding="10" 
                        Command="{Binding GetHtmlCommand}" Background="#9C27B0" Foreground="White"/>
                <Button Content="📝 Text" Margin="0,5" Padding="10" 
                        Command="{Binding GetTextCommand}" Background="#607D8B" Foreground="White"/>
                
                <Separator Margin="0,15"/>
                
                <TextBlock Text="Pages" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding Pages}" DisplayMemberPath="Title" 
                         SelectedItem="{Binding SelectedPage}" SelectionMode="Single"/>
                
                <Separator Margin="0,15"/>
                
                <TextBlock Text="API Status" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ApiStatus}" Foreground="{Binding ApiStatusColor}"/>
                <TextBlock Text="Browser: {Binding BrowserStatus}" Foreground="{Binding BrowserStatusColor}"/>
            </StackPanel>
        </Border>
        
        <!-- Center Panel - Browser View -->
        <Border Grid.Column="1" Background="White" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- URL Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="←" Width="40" Command="{Binding BackCommand}" ToolTip="Back"/>
                    <Button Content="→" Width="40" Command="{Binding ForwardCommand}" ToolTip="Forward"/>
                    <TextBox Text="{Binding CurrentUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Width="*" Margin="5" VerticalAlignment="Center" 
                             KeyDown="UrlTextBox_KeyDown"/>
                    <Button Content="Go" Width="60" Command="{Binding NavigateCommand}" Background="#2196F3" Foreground="White"/>
                </DockPanel>
                
                <!-- Browser Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Screenshot Display -->
                        <Image Source="{Binding ScreenshotImage}" Stretch="Uniform" 
                               MaxHeight="600" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- HTML Content Display -->
                        <TextBlock Text="{Binding HtmlContent}" TextWrapping="Wrap" 
                                   FontFamily="Consolas" FontSize="12" 
                                   Visibility="{Binding HtmlContentVisibility}" 
                                   Margin="0,0,0,20"/>
                        
                        <!-- Text Content Display -->
                        <TextBlock Text="{Binding TextContent}" TextWrapping="Wrap" 
                                   FontFamily="Segoe UI" FontSize="12" 
                                   Visibility="{Binding TextContentVisibility}" 
                                   Margin="0,0,0,20"/>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Status Bar -->
                <StatusBar Grid.Row="2">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Border>
        
        <!-- Right Panel - JavaScript & Actions -->
        <Border Grid.Column="2" Background="#f5f5f5" Padding="10">
            <StackPanel>
                <TextBlock Text="JavaScript Console" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox Text="{Binding JavaScriptCode, Mode=TwoWay}" 
                         AcceptsReturn="True" Height="100" 
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <Button Content="▶ Run JS" Margin="0,5" Padding="10" 
                        Command="{Binding ExecuteJsCommand}" Background="#4CAF50" Foreground="White"/>
                
                <Separator Margin="0,15"/>
                
                <TextBlock Text="DOM Actions" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox Text="{Binding Selector, Mode=TwoWay}" 
                         PlaceholderText="CSS Selector" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Value, Mode=TwoWay}" 
                         PlaceholderText="Value (for fill)" Margin="0,0,0,5"/>
                <Button Content="👆 Click" Margin="0,5" Padding="10" 
                        Command="{Binding ClickCommand}" Background="#FF9800" Foreground="White"/>
                <Button Content="✏️ Fill" Margin="0,5" Padding="10" 
                        Command="{Binding FillCommand}" Background="#9C27B0" Foreground="White"/>
                
                <Separator Margin="0,15"/>
                
                <TextBlock Text="Settings" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="API Base URL:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ApiBaseUrl, Mode=TwoWay}" 
                         PlaceholderText="http://localhost:5000" Margin="0,0,0,10"/>
                <Button Content="🔄 Test Connection" 
                        Command="{Binding TestConnectionCommand}" Background="#607D8B" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
