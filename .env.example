# ProxyBox Environment Variables
# Copy this file to .env and customize the values

# Proxy Server Configuration
PROXY_SERVER=http://localhost:8080

# DNS Server Configuration (optional - for advanced DNS routing)
DNS_SERVER=127.0.0.1

# Flask API Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Mitmproxy Configuration
MITMPROXY_PORT=8080

# Dnsmasq Configuration (optional - for DNS server)
DNSMASQ_PORT=53

# Example DNS Routes (comma-separated: domain:ip)
# DNS_ROUTES=example.com:10.58.54.2,test.com:192.168.1.1
