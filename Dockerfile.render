# Dockerfile per Render.com (Single Container)
# Combina API Flask + Mitmproxy + Playwright in un solo container
# Ottimizzato per Render Free Tier

FROM python:3.10-slim

# 1. Installa dipendenze di sistema per Playwright
RUN apt-get update && apt-get install -y \
    wget \
    git \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# 2. Installa Python packages
RUN pip install --no-cache-dir playwright mitmproxy flask flask-cors gunicorn

# 3. Installa browser per Playwright (Chromium)
RUN playwright install chromium --with-deps

# 4. Copia i file dell'applicazione
WORKDIR /app
COPY api/app.py /app/app.py
COPY api/mitmproxy_script.py /app/mitmproxy_script.py
COPY api/dns_manager.py /app/dns_manager.py
COPY api/templates /app/templates

# 5. Crea script di avvio per tutti i servizi
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Starting Mitmproxy in headless mode..."' >> /app/start.sh && \
    echo 'mitmdump -s /app/mitmproxy_script.py --listen-port 8080 --no-http2 --ssl-insecure --mode transparent --showhost &' >> /app/start.sh && \
    echo 'MITMPROXY_PID=$!' >> /app/start.sh && \
    echo 'echo "Waiting for Mitmproxy to start..."' >> /app/start.sh && \
    echo 'sleep 3' >> /app/start.sh && \
    echo 'echo "Starting Flask API..."' >> /app/start.sh && \
    echo 'exec gunicorn --bind 0.0.0.0:5000 --workers 1 --threads 1 --timeout 300 app:app' >> /app/start.sh && \
    chmod +x /app/start.sh

# 6. Espone le porte necessarie
EXPOSE 5000 8080

# 7. Comando di avvio
CMD ["/app/start.sh"]
