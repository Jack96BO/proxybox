# Dockerfile per ProxyBox su Render.com
# Architettura: Chromium Standalone + CDP + Playwright + Mitmproxy
# 
# CONTROL PLANE:
#   Flask API (porta 5000) - Control plane principale
#   
# BROWSER LAYER:
#   Chromium standalone (porta 9222 CDP) - Browser remoto
#   Playwright - Connessione via CDP
#   
# NETWORK LAYER:
#   Mitmproxy (porta 8080) - Intercettazione traffico
#   DNS Manager - Gestione route DNS
#
# DATI PERSISTENTI:
#   /data/chromium - User data directory (cookies, storage, ecc.)

FROM python:3.10-slim

# ============================================================================
# 1. Installa dipendenze di sistema
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Chromium dependencies
    chromium \
    chromium-sandbox \
    chromium-driver \
    
    # Playwright dependencies
    wget \
    git \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    
    # Mitmproxy dependencies
    openssl \
    
    # Utility
    curl \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# 2. Installa Python packages
# ============================================================================
RUN pip install --no-cache-dir \
    playwright==1.40.0 \
    mitmproxy==10.2.3 \
    flask==2.3.3 \
    flask-cors==4.0.0 \
    gunicorn==21.2.0 \
    python-dotenv==1.0.0

# ============================================================================
# 3. Configura Chromium
# ============================================================================
# Creiamo un wrapper per Chromium che usa le librerie corrette
RUN ln -sf /usr/bin/chromium /usr/bin/chromium-browser || true

# ============================================================================
# 4. Crea struttura directory
# ============================================================================
RUN mkdir -p /app/api/browser \
    /app/api/network \
    /app/api/mitmproxy \
    /app/scripts \
    /app/data/chromium \
    /app/logs

# ============================================================================
# 5. Copia file dell'applicazione
# ============================================================================
WORKDIR /app

# Copia il codice sorgente
COPY api/ /app/api/
COPY scripts/ /app/scripts/
COPY .env.example /app/.env.example

# ============================================================================
# 6. Rendi eseguibili gli script
# ============================================================================
RUN chmod +x /app/scripts/*.sh

# ============================================================================
# 7. Script di avvio
# ============================================================================
# Lo script start.sh avvia:
# 1. Mitmproxy (porta 8080)
# 2. Chromium standalone (porta 9222 CDP)
# 3. Flask API (porta 5000)
CMD ["/app/scripts/start.sh"]

# ============================================================================
# 8. Espone le porte
# ============================================================================
EXPOSE 5000 8080 9222

# ============================================================================
# 9. Volume per dati persistenti
# ============================================================================
# Su Render, usa l'opzione "Persistent Disk" per /data
VOLUME ["/data/chromium"]
